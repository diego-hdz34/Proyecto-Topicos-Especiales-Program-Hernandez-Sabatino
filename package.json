{
    "name": "smartfetch",
    "version": "1.0.0",
    "description": "Librería ligera y resiliente sobre la API nativa fetch sin dependencias externas.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "fetch",
        "http",
        "client",
        "axios-alternative",
        "wrapper",
        "typescript",
        "smartfetch"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.15.21",
        "jest": "^29.7.0",
        "ts-jest": "^29.3.4",
        "typescript": "^5.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/tests"
        ],
        "testMatch": [
            "**/*.test.ts"
        ],
        "transform": {
            "^.+\\.tsx?$": [
                "ts-jest",
                {
                    "tsconfig": "tsconfig.test.json"
                }
            ]
        },
        "moduleFileExtensions": [
            "ts",
            "js",
            "json"
        ],
        "collectCoverageFrom": [
            "src/**/*.ts"
        ]
    }
}
